# Environment dan informasi rahasia
.env
.env.*

# Tetap izinkan template konfigurasi contoh
!.env.example

# Dependensi Composer
/vendor/

# File sementara CodeIgniter
/writable/cache/*
!/writable/cache/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html

# File sistem lokal
.DS_Store
Thumbs.db
